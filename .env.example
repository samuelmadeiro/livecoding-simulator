# Modelo das variaveis de ambiente do projeto. Copie para .env e ajuste.
#
#   cp .env.example .env
#
# O .env fica fora do Git (veja .gitignore); este arquivo e versionado e por isso
# nao pode conter segredo de verdade.
#
# ATENCAO: o Spring Boot nao le .env sozinho. As variaveis precisam estar no
# ambiente do processo antes de subir a aplicacao. No PowerShell:
#
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object {
#       $par = $_ -split '=', 2
#       [Environment]::SetEnvironmentVariable($par[0].Trim(), $par[1].Trim(), 'Process')
#   }
#   .\mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=pg"
#
# No bash: set -a; source .env; set +a
#
# Sem nada disso a aplicacao continua subindo: todas as chaves abaixo tem valor
# padrao de desenvolvimento em application.properties. O .env serve para trocar
# esses padroes sem editar arquivo versionado.

# ---------- Banco ----------
# Porta 8090 e a da instalacao local; num PostgreSQL padrao use 5432.
DB_URL=jdbc:postgresql://localhost:8090/livecoding
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# ---------- JWT ----------
# Chave base64 de 256 bits. Em producao e obrigatoria: o perfil prod nao tem
# default e a aplicacao nao sobe sem ela. Gere uma nova com:
#   openssl rand -base64 32
JWT_SECRET=
# Validade do token em milissegundos (3600000 = 1 hora).
JWT_EXPIRACAO_MS=3600000

# ---------- Admin ----------
# O admin so nasce se email e senha estiverem preenchidos. Em producao, sem
# esses valores nenhum administrador e criado, o que e proposital.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# ---------- CORS ----------
# Origens do front-end, separadas por virgula. Em producao, o dominio real.
CORS_ALLOWED_ORIGINS=http://localhost:5173
